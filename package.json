{
  "name": "state-switch",
  "version": "2.0.0",
  "description": "State Switch is a Change Monitor/Guarder for Async Actions.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "demo": "node example/demo.ts",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint src tests",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test src tests",
    "test:unit:deno": "deno test --no-check --allow-env src tests",
    "test:pack": "bash -x scripts/npm-pack-testing.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/state-switch.git"
  },
  "keywords": [
    "state",
    "switch",
    "monitor",
    "async"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/state-switch/issues"
  },
  "homepage": "https://github.com/huan/state-switch#readme",
  "dependencies": {
    "xstate": "^4.26.1"
  },
  "peerDependencies": {
    "brolog": ">=1.14.2",
    "gerror": "^1.0.16",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "brolog": "^1.14.2",
    "gerror": "^1.0.16",
    "rxjs": "^7.4.0",
    "shx": "^0.3.4",
    "typed-emitter": "^1.5.0-from-event"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
